{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "customConditions": ["source"]
  },
  "include": ["packages/*/src/**/*.test.ts", "apps/*/src/**/*.test.ts", "tests/**/*.ts"]
}
