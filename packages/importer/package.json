  "files": [
    "dist"
  ],
  "dependencies": {
    "@edithtml/core": "workspace:*",
    "@types/mdast": "^4.0.4",
    "mdast-util-from-markdown": "^2.1.0",
    "micromark-util-types": "^2.0.3"
  }
}
